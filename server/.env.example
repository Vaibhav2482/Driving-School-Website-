# Copy to server/.env and fill in. NEVER commit server/.env.
# Every value below is a placeholder; none of them is a real secret.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=4000
# LOG_LEVEL=debug               # optional: fatal|error|warn|info|debug|trace|silent

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Create a dedicated user and database for this app; do not use the "postgres" superuser.
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL=postgresql://srisaibalaji:<db-password>@localhost:5432/srisaibalaji_dev

# ── Auth ───────────────────────────────────────────────────────────────────
# Two DIFFERENT random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=<change-me: generate a random secret>
JWT_REFRESH_SECRET=<change-me: generate a different random secret>
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Web app ────────────────────────────────────────────────────────────────
# Public origin of the React app (CORS allow-list and links in emails). Must be https in production.
CLIENT_URL=http://localhost:5273

# ── Business ───────────────────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Kolkata

# ── Networking / abuse protection ──────────────────────────────────────────
# Number of reverse proxies in front of the API (0 when running locally without one).
TRUST_PROXY=0
# Requests allowed per IP per 15 minutes across the API.
RATE_LIMIT_MAX=300
# Enquiry form submissions allowed per IP per hour.
ENQUIRY_RATE_LIMIT_MAX=8

# ── Seed: OWNER bootstrap account (used only by `npm run seed`) ────────────
# These create the first OWNER account. The password must be changed at first sign-in.
SEED_OWNER_EMAIL=<owner-email@example.com>
SEED_OWNER_PASSWORD=<change-me: at least 12 characters>
# SEED_OWNER_NAME=P. Mahesh
# SEED_OWNER_PHONE=+91XXXXXXXXXX

# ── Seed: development data (used only by `npm run seed:dev`) ───────────────
# Optional shared password for the fake [DEV] users. If unset, a random one is generated and printed once.
# SEED_DEV_PASSWORD=

# ── Sign-in protection ─────────────────────────────────────────────────────
# bcrypt work factor (production requires at least 10).
# PASSWORD_HASH_COST=12
# Failed sign-in attempts allowed per IP per 15 minutes.
# LOGIN_RATE_LIMIT_MAX=10
# Password-reset / invitation requests allowed per IP per hour.
# PASSWORD_RESET_RATE_LIMIT_MAX=5

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# With no SMTP_HOST, email runs in DEVELOPMENT mode: messages are written to the server log and NOT sent.
# In production all of SMTP_HOST, SMTP_PORT, SMTP_FROM and OWNER_NOTIFICATION_EMAIL are required.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false             # true = implicit TLS (usually port 465)
# SMTP_USER=<smtp-username>
# SMTP_PASSWORD=<smtp-password>
# SMTP_FROM="Sri Sai Balaji Driving School <no-reply@example.com>"
# Where new-enquiry emails go. Set this to the owner's real address; it is never guessed.
# OWNER_NOTIFICATION_EMAIL=<owner-email@example.com>

# ── Local development helper ───────────────────────────────────────────────
# When true AND no SMTP is configured, invitation / password-reset links are written to the server log so
# the flow can be tried locally. Refused in production.
# AUTH_DEV_LOG_LINKS=true
