# Optional. Copy to client/.env.local and adjust. Only VITE_-prefixed values reach the browser, so NEVER put
# secrets here. The website needs no configuration to run.

# Dev server port (default 5273, strictPort).
# VITE_DEV_PORT=5273

# Public origin of the deployed website (no trailing slash). Enables canonical and Open Graph URLs.
# Leave unset in development.
# VITE_SITE_URL=https://www.example.com
