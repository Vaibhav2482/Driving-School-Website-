# Copy to client/.env.local and adjust. Only VITE_-prefixed values are exposed to the browser,
# so NEVER put secrets here.

# Base URL of the API. The default "/api/v1" is same-origin: in development Vite proxies /api to
# the Express server, and in production the reverse proxy does the same.
VITE_API_BASE_URL=/api/v1

# Dev server port for this project (default 5273, strictPort).
# VITE_DEV_PORT=5273

# Where Vite's dev proxy forwards /api (must match server PORT).
# VITE_DEV_API_TARGET=http://localhost:4000

# PHASE 1 ONLY: real authentication arrives in Phase 3. Until then the role guards would hide every
# admin/student/instructor placeholder page, so in development (never in production builds) this
# flag lets you view them. Remove in Phase 3.
VITE_DEV_BYPASS_AUTH_GUARDS=true

# Public origin of the deployed website (no trailing slash). Enables canonical and Open Graph URLs.
# Leave unset in development.
# VITE_SITE_URL=https://www.example.com
